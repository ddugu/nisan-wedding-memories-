# Copy to .env.local for local development.
# For production, set these in Firebase App Hosting (Console or apphosting secrets).
# NEVER commit real secret values to git.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — required for /api/memories upload) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Security (required in production) ---
IP_HASH_SALT=

# --- Admin panel (comma-separated emails) ---
ADMIN_EMAILS=

# --- Optional site config ---
NEXT_PUBLIC_WEDDING_DATE=2026-09-02
MAX_FILE_SIZE_MB=10
MAX_TOTAL_STORAGE_GB=10
MAX_PHOTOS_PER_GUEST=20
RATE_LIMIT_UPLOADS_PER_HOUR=10
