# Copy to .env.local for local development.
# For production, set these in Firebase App Hosting (Console or apphosting secrets).
# NEVER commit real secret values to git.

# --- Supabase (public) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only — required for /api/memories upload) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- Security (required in production) ---
IP_HASH_SALT=

# --- Admin panel (comma-separated emails) ---
ADMIN_EMAILS=

# --- Upload & storage limits ---
# Supabase Free tier = ~1 GB file storage. Keep MAX_TOTAL_STORAGE_GB below your plan limit.
# Pro tier = 100 GB. Set MAX_TOTAL_STORAGE_GB accordingly in Vercel env vars.
NEXT_PUBLIC_WEDDING_DATE=2026-09-02
MAX_FILE_SIZE_MB=5
MAX_TOTAL_STORAGE_GB=0.9
MAX_PHOTOS_PER_GUEST=15
RATE_LIMIT_UPLOADS_PER_HOUR=5
